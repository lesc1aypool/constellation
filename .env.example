# Copy this file to .env (repo root) and fill in values. .env is git-ignored.

# Last.fm API key (free: https://www.last.fm/api/account/create). Only the key is needed, not the shared secret.
LASTFM_API_KEY=

# Optional: override the User-Agent sent to MusicBrainz/ListenBrainz. MusicBrainz requires one that
# names the app and a way to contact you (a URL is fine).
# MUSICBRAINZ_USER_AGENT=constellation-prototype/0.1 (https://github.com/lesc1aypool/constellation)
